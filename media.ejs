```{=html}
<%
// Groups press items (rows of media.yml) by paper, keeping the file's order.
const groups = [];
for (const item of items) {
  let g = groups.find(x => x.paper === item.paper);
  if (!g) {
    g = { paper: item.paper, title: item["paper-title"], venue: item["paper-venue"], url: item["paper-url"], rows: [] };
    groups.push(g);
  }
  g.rows.push(item);
}
const MONTHS = ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"];
const fmt = d => {
  const m = /^(\d{4})-(\d{2})-(\d{2})/.exec(String(d || ""));
  return m ? `${Number(m[3])} ${MONTHS[Number(m[2]) - 1]} ${m[1]}` : "";
};
%>
<div class="media-list">
<% for (const g of groups) { %>
  <div class="media-group">
    <div class="media-paper"><a href="<%= g.url %>"><%= g.title %></a></div>
    <div class="media-venue"><%= g.venue %></div>
    <ul class="media-items">
    <% for (const r of g.rows) { %>
      <li><span class="media-outlet"><%= r.outlet %></span>
        <a href="<%= r.href %>" target="_blank" rel="noopener"><%= r.title %></a>
        <span class="media-date"><%= fmt(r.published) %></span></li>
    <% } %>
    </ul>
  </div>
<% } %>
</div>
```
